  <diagram name="DevOps Identity Flow" id="devops-flow">
    <mxGraphModel dx="1200" dy="400" grid="1" gridSize="40" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
