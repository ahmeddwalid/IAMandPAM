<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.7">
  <diagram id="ciem-architecture" name="CIEM and Identity Posture Architecture">
    <mxGraphModel dx="800" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Nodes -->
        <mxCell id="cloud_estate" value="Multi-Cloud Estate&#10;AWS Orgs / Azure Tenants / GCP&#10;(Roles, Policies, Service Accounts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#3d352a;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="telemetry" value="Activity Telemetry&#10;AWS CloudTrail / Azure Logs&#10;real-time API calls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#3d352a;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
