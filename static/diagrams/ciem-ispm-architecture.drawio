        <mxCell id="e3" value="granted vs used delta" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#b76e2e;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="ciem_engine" target="risk_detector">
          <mxGeometry relative="1" as="geometry"/>
