        <mxCell id="e2" value="event stream ingestion" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="telemetry" target="ciem_engine">
          <mxGeometry relative="1" as="geometry"/>
