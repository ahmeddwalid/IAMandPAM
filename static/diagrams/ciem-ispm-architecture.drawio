        <mxCell id="remediation" value="Automated Remediation&#10;generates least-privilege&#10;Terraform / SCP pull requests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7ead9;strokeColor=#b76e2e;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="soc" value="Security Team Dashboard&#10;entitlement drift alerts&#10;&amp; posture scoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#3d352a;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="270" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="IAM configuration snapshot" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="cloud_estate" target="ciem_engine">
          <mxGeometry relative="1" as="geometry"/>
