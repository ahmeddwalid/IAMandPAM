        <mxCell id="ciem_engine" value="CIEM Analysis Engine&#10;Effective Permissions Calculator&#10;SCPs + Boundaries + Roles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7ead9;strokeColor=#b76e2e;fontColor=#3d352a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="risk_detector" value="Privilege Escalation Detector&#10;identifies toxic permissions&#10;(e.g. PassRole + Lambda)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#7a6e5f;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="220" height="80" as="geometry"/>
