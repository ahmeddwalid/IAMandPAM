          </mxGeometry>
        </mxCell>

        <mxCell id="e7" value="7. streams audit logs" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="proxy" target="siem">
          <mxGeometry relative="1" as="geometry"/>
