<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.7">
  <diagram id="zsp-flow" name="Zero Standing Privilege Ephemeral Access">
    <mxGraphModel dx="800" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Nodes -->
        <mxCell id="user" value="Engineer / Operator&#10;requires emergency access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#3d352a;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="idp" value="Corporate IdP&#10;(Okta / Entra ID)&#10;FIDO2 Phish-Resistant MFA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#3d352a;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ca_broker" value="Ephemeral Access Broker &amp; CA&#10;(Teleport / Boundary)&#10;evaluates JIT policy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7ead9;strokeColor=#b76e2e;fontColor=#3d352a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="proxy" value="Session Proxy &amp; Recorder&#10;protocol validation&#10;(SSH / RDP / SQL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#7a6e5f;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="270" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="target" value="Target Server / Database&#10;trusts CA public key&#10;zero local accounts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7ead9;strokeColor=#b76e2e;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="siem" value="SIEM &amp; Audit Storage&#10;keystroke logs + video" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ef;strokeColor=#3d352a;fontColor=#3d352a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="1. requests JIT session" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="user" target="ca_broker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="2. redirects to authenticate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=1;dashed=1;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="ca_broker" target="idp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="280"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" value="3. authenticates with FIDO2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="user" target="idp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="4. issues 1-hour signed certificate&#10;(user receives ephemeral cert)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#b76e2e;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="ca_broker" target="user">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="150"/>
              <mxPoint x="280" y="90"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e5" value="5. connects via proxy with cert" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#b76e2e;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="user" target="proxy">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="60"/>
              <mxPoint x="260" y="310"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" value="6. injects session into target" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#94541f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="proxy" target="target">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="310"/>
              <mxPoint x="580" y="165"/>
