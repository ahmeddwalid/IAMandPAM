        <mxCell id="e7" value="enforces offline caching policy" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#7a6e5f;strokeWidth=2;fontColor=#3d352a;fontSize=11;labelBackgroundColor=#f8f6f2;" edge="1" parent="1" source="resilience_controller" target="core_infra">
          <mxGeometry relative="1" as="geometry"/>
